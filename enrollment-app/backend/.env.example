# Database
DATABASE_URL="postgresql://user:password@localhost:5432/capoeira_enrollment"

# Server
PORT=5000
NODE_ENV=development

# JWT
JWT_SECRET=your-secret-key-here-change-in-production
JWT_EXPIRY=7d

# CORS
FRONTEND_URL=http://localhost:3000

# Email Configuration (SMTP)
# Example: SendGrid (SMTP_USER is literally "apikey", SMTP_PASS is your SendGrid API key)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASS=
SMTP_FROM_EMAIL=your-verified-sender@example.com
SMTP_FROM_NAME=Portal Modelo Capoeira

# Instructor Email (where to send enrollment notifications)
INSTRUCTOR_EMAIL=instructor@example.com

# Security guard: prevent connecting to an empty or wrong database
BOOTSTRAP_ADMIN_EMAIL=admin@portalmodelo.com
BOOTSTRAP_ADMIN_PASSWORD=ChangeThisPassword123!
ALLOW_EMPTY_DB=false
